{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moon Dancer",
  "version": "1.0.0",
  "identifier": "com.moondancer.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Moon Dancer",
        "width": 1260,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": false
      },
      {
        "label": "mascot",
        "title": "Moon Dancer Mascote",
        "url": "index.html?window=mascot",
        "width": 128,
        "height": 128,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "noRedirectionBitmap": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "A private, offline-first lunar journal",
    "longDescription": "A personal desktop space for journaling, notes, memories, and the lunar calendar, with data stored locally on the user's computer."
  }
}
