{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moon Dancer",
  "version": "0.1.0",
  "identifier": "com.moondancer.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Moon Dancer",
        "width": 1260,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "appimage", "deb"],
    "icon": ["icons/icon.png"],
    "shortDescription": "Um diário para uma vida mais lunar",
    "longDescription": "Diário, notas, memórias e calendário lunar com dados guardados no próprio computador."
  }
}
